<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MakayWallpaper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorPrimary">#4ECDC4</item>
        <item name="android:colorAccent">#4ECDC4</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#4ECDC4</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MakayWallpaper</item>
    </style>
</resources>
